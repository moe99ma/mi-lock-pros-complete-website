{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1180px"
    },
    "color": {
      "palette": [
        { "slug": "black", "name": "Black", "color": "#050504" },
        { "slug": "ivory", "name": "Ivory", "color": "#fffaf0" },
        { "slug": "gold", "name": "MI Gold", "color": "#d7ad45" },
        { "slug": "muted-gold", "name": "Muted Gold", "color": "#a97919" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "system", "name": "System Sans", "fontFamily": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#050504", "text": "#fffaf0" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system)" }
  }
}
